{
    "name": "lavashark",
    "version": "2.3.3",
    "description": "A lightweight Lavalink client built with Node.js",
    "main": "dist/src/index.js",
    "types": "typings/src/index.d.ts",
    "files": [
        "dist/",
        "typings"
    ],
    "scripts": {
        "build": "tsc",
        "test": "npm run build && npm run test:apple-music && npm run test:deezer && npm run test:spotify",
        "test:apple-music": "tsx scripts/test-sources-apple-music.ts",
        "test:deezer": "tsx scripts/test-sources-deezer.ts",
        "test:spotify": "tsx scripts/test-sources-spotify.ts",
        "lint": "eslint . --ext .ts --color",
        "typecheck": "tsc --noEmit",
        "docs": "typedoc --json docs/typedoc.json --options typedoc-config.json"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/hmes98318/LavaShark.git"
    },
    "author": "hmes98318",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/hmes98318/LavaShark/issues"
    },
    "homepage": "https://lavashark.js.org",
    "dependencies": {
        "otpauth": "^9.5.1",
        "undici": "^8.10.0",
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/ws": "^8.18.1",
        "discord.js": "^14.27.0",
        "eslint": "^10.8.1",
        "globals": "^17.9.0",
        "tsx": "^4.23.11",
        "typedoc": "^0.28.20",
        "typedoc-plugin-markdown": "^4.12.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.66.0"
    },
    "engines": {
        "node": ">=22.19.0"
    },
    "keywords": [
        "lavalink",
        "api",
        "client",
        "lavalink-api",
        "lightweight",
        "music",
        "discord",
        "discord.js",
        "bot"
    ]
}
